// B359 – Minimum interval violation by one minute.
// Fosamax is scheduled at minute 371 and Moment at minute 730, resulting in an interval of only 359 minutes.
// This violates the required 360-minute minimum interval and the assumption inv_A_timeConsumption.
setup CM as MRMModels/configurationMgrGap359.asm
setup RES as MRMModels/reschedulerGap359.asm
setup setup_comp as ( CM || RES )
setup C1 as MRMModels/compartment.asm
setup C2 as MRMModels/compartment.asm
setup PB as MRMModels/pillboxGap359.asm
//RUN STEP 1:
run(setup_comp, {pillboxSystemTime=0;day=0;isPillMissed(compartment1)=false;pillTakenWithDelay(compartment1)=false;isPillMissed(compartment2)=false;pillTakenWithDelay(compartment2)=false;redLed(compartment1)=OFF;redLed(compartment2)=OFF;name(compartment1)="fosamax";name(compartment2)="moment";time_consumption(compartment1)=[371];time_consumption(compartment2)=[730,1140];actual_time_consumption(compartment1)=[0];actual_time_consumption(compartment2)=[0,0];drugIndex(compartment1)=0;drugIndex(compartment2)=0})
//RUN STEP 2:
run(C1, {compartmentOpen(1)=false;outMess(1)="";led(1)=OFF;myID=1;outMess(undef)="";led(undef)=OFF})
//RUN STEP 3:
run(C2, {myID=2;compartmentOpen(2)=false;outMess(2)="";led(2)=OFF;outMess(undef)="";led(undef)=OFF})
setup pillbox_comp as  ( ( PB <|> ( CM || RES ) ) <|> ( C1 || C2 ) )
//RUN STEP 4:
run(pillbox_comp, {myID=undef;outMess(undef)="";led(undef)=OFF;compartmentOpen(1)=false;compartmentOpen(2)=false;systemTime=10n;skipNextPill(compartment1)=false;skipNextPill(compartment2)=false;skipNextPill(compartment1,compartment2)=false;skipNextPill(compartment2,compartment1)=false;newTime(compartment1)=0n;newTime(compartment2)=0n;setOriginalTime(compartment1)=false;setOriginalTime(compartment2)=false;setNewTime(compartment1)=false;setNewTime(compartment2)=false;openSwitch(1)=false;openSwitch(2)=false;})
//The user does not open the compartment 1 with "fosamax" pill to be taken at systemTime 360 within 20 minutes
//RUN STEP 5:
run(pillbox_comp, {myID=undef;outMess(undef)="";led(undef)=OFF;compartmentOpen(1)=false;compartmentOpen(2)=false;systemTime=361n})
//RUN STEP 6:
run(pillbox_comp, {myID=undef;outMess(undef)="";led(undef)=OFF;compartmentOpen(1)=false;compartmentOpen(2)=false;systemTime=366n})
//20 minutes elapsed and the pill has not been taken since the compartment 1 is still closed, and the system does not reschedule it since it interferes with the next pill.
//RUN STEP 7:
run(pillbox_comp, {myID=undef;outMess(undef)="";led(undef)=OFF;compartmentOpen(1)=false;compartmentOpen(2)=false;systemTime=381n})
//RUN STEP 8:
run(pillbox_comp, {myID=undef;outMess(undef)="";led(undef)=OFF;compartmentOpen(1)=false;compartmentOpen(2)=false;systemTime=395n})




